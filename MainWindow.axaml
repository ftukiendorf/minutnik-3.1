<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="560"
        x:Class="Minutnik.MainWindow"
        Title="Minutnik Pomodoro"
        Width="520" Height="560"
        MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*,Auto" Margin="32">
        <StackPanel Spacing="8">
            <TextBlock Text="Minutnik Pomodoro"
                       FontSize="26"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="PhaseLabel"
                       Text="Praca"
                       FontSize="16"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,24"
                Padding="24"
                CornerRadius="16"
                Background="#F1F3F5">
            <StackPanel VerticalAlignment="Center" Spacing="24">
                <TextBlock x:Name="TimeDisplay"
                           Text="25:00"
                           FontSize="76"
                           FontWeight="Light"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="Skończone cykle:"
                               FontSize="16"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CycleCountLabel"
                               Text="0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="StatusLabel"
                           Text="Gotowy do pracy"
                           HorizontalAlignment="Center"
                           Opacity="0.7" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="20">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="24">
                <StackPanel Spacing="6">
                    <TextBlock Text="Praca (min)"
                               HorizontalAlignment="Center" />
                    <NumericUpDown x:Name="WorkDurationInput"
                                   Width="110"
                                   Minimum="1"
                                   Maximum="180"
                                   Value="25"
                                   Increment="1"
                                   FormatString="0"
                                   TextAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Przerwa (min)"
                               HorizontalAlignment="Center" />
                    <NumericUpDown x:Name="BreakDurationInput"
                                   Width="110"
                                   Minimum="1"
                                   Maximum="180"
                                   Value="5"
                                   Increment="1"
                                   FormatString="0"
                                   TextAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12">
                <Button x:Name="StartPauseButton"
                        Content="Start"
                        MinWidth="120"
                        Click="OnStartPauseClick" />
                <Button Content="Resetuj"
                        MinWidth="100"
                        Click="OnResetClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
